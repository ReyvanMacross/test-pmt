# Salin file ini menjadi .env.local dan isi dari Supabase Dashboard > Connect.
# Untuk uji lokal Windows, gunakan URI Session pooler (port 5432) yang disalin dari dashboard.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres
DB_SSL=true
DB_POOL_MAX=5
SESSION_SECRET=GANTI_DENGAN_SECRET_RANDOM_MINIMAL_32_KARAKTER
